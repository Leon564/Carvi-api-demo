# URL base de la API de socios de Carvi (incluye /integrations/v1)
CARVI_API_BASE_URL=http://localhost:3000/integrations/v1
# Sandbox desplegado (cambia solo esta línea; la credencial debe ser de ese entorno):
# CARVI_API_BASE_URL=https://<host-del-sandbox>/integrations/v1
# Credencial creada desde el portal de integraciones
CARVI_CLIENT_ID=
CARVI_CLIENT_SECRET=
# Secretos de webhook separados por coma (dos durante una rotación).
# Vacío = la credencial no tiene secreto: Carvi entrega igual, sin la cabecera X-Carvi-Signature
CARVI_WEBHOOK_SECRETS=
# Token de autorización del webhook (el webhookAuthToken configurado en el portal).
# Si se define, el demo exige Authorization: Bearer <token> en cada entrega. Vacío = no se exige
CARVI_WEBHOOK_AUTH_TOKEN=
# Contraseña para publicar el demo (HTTP Basic, cualquier usuario). Vacío = el servidor solo
# acepta peticiones locales; /webhooks/carvi queda siempre fuera de esta protección
DEMO_PASSWORD=
# Interfaz en la que escucha el servidor. En un hosting (Render, etc.) debe ser 0.0.0.0
HOST=127.0.0.1
# Puerto del servidor local del demo
PORT=4020
# URL que hay que configurar como webhookUrl en el portal
PUBLIC_WEBHOOK_URL=http://localhost:4020/webhooks/carvi
